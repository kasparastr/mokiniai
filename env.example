# Copy this file to .env for local development.
# In production (Render), set these as real environment variables in the dashboard instead.

# Get this from your Neon project dashboard (Connection Details -> pooled connection string)
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Pick any password. Required to open the site once deployed. Leave unset locally if you don't want the prompt.
APP_PASSWORD=changeme

PORT=3000

# Optional: syncs lessons to Google Calendar (one-way, Pamoka -> Google).
# Create an OAuth client at console.cloud.google.com (APIs & Services ->
# Credentials -> OAuth client ID -> Web application), enable the Google
# Calendar API, and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
# Leave unset to skip the feature entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mokiniai.onrender.com/auth/google/callback
